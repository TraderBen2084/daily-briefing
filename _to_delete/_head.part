<!doctype html>
<html lang="zh-Hant">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>每日市場簡報 · 2026-10-28</title>
<style>
:root{
  --primary:#fcd535; --primary-active:#f0b90b;
  --canvas:#0b0e11; --card:#1e2329; --elev:#2b3139;
  --hairline:#2b3139; --body:#eaecef; --muted:#707a8a; --muted-strong:#929aa5;
  --up:#0ecb81; --down:#f6465d; --turq:#2dbdb6; --info:#3b82f6;
  --ink:#181a20;
  --r-sm:4px; --r-md:6px; --r-lg:8px; --r-xl:12px; --r-pill:9999px;
}
*{box-sizing:border-box}
html,body{margin:0;padding:0}
body{
  background:var(--canvas); color:var(--body);
  font-family:-apple-system,BlinkMacSystemFont,"Helvetica Neue","PingFang TC","Noto Sans TC","Microsoft JhengHei",sans-serif;
  font-size:14px; line-height:1.5; -webkit-font-smoothing:antialiased;
}
.num{font-variant-numeric:tabular-nums;font-feature-settings:"tnum"}
.wrap{max-width:1180px;margin:0 auto;padding:0 16px 72px}
a{color:var(--primary);text-decoration:none}

header{border-bottom:1px solid var(--hairline);background:var(--canvas);padding:28px 0 22px;margin-bottom:28px}
.kicker{display:inline-flex;align-items:center;gap:8px;font-size:12px;font-weight:500;letter-spacing:.08em;text-transform:uppercase;color:var(--muted-strong)}
.dot{width:7px;height:7px;border-radius:var(--r-pill);background:var(--primary);display:inline-block}
h1{margin:10px 0 6px;font-size:40px;line-height:1.12;letter-spacing:-.4px;font-weight:700}
h1 em{font-style:normal;color:var(--primary)}
.sub{color:var(--muted);font-size:13px}
.closed{display:inline-block;margin-top:12px;font-size:12px;font-weight:600;padding:6px 12px;border-radius:var(--r-pill);background:rgba(252,213,53,.12);color:var(--primary);border:1px solid rgba(252,213,53,.3)}

.strip{display:grid;grid-template-columns:repeat(auto-fit,minmax(132px,1fr));gap:1px;background:var(--hairline);border:1px solid var(--hairline);border-radius:var(--r-xl);overflow:hidden;margin-bottom:32px}
.tk{background:var(--card);padding:14px 16px}
.tk .lbl{font-size:11px;font-weight:500;color:var(--muted);letter-spacing:.04em;text-transform:uppercase}
.tk .val{font-size:18px;font-weight:600;margin-top:5px}
.tk .chg{font-size:12px;font-weight:500;margin-top:2px}
.up{color:var(--up)} .down{color:var(--down)} .flat{color:var(--muted-strong)}

section{margin-bottom:38px}
h2{font-size:22px;font-weight:600;margin:0 0 4px;display:flex;align-items:center;gap:10px}
h2 .bar{width:4px;height:20px;background:var(--primary);border-radius:2px;display:inline-block}
.secnote{color:var(--muted);font-size:12px;margin:0 0 16px 14px}
.grid2{display:grid;grid-template-columns:1fr 1fr;gap:16px}
.grid3{display:grid;grid-template-columns:repeat(3,1fr);gap:16px}
.card{background:var(--card);border:1px solid var(--hairline);border-radius:var(--r-xl);padding:20px 22px}
.card h3{margin:0 0 12px;font-size:16px;font-weight:600}
ul.bul{list-style:none;margin:0;padding:0}
ul.bul li{position:relative;padding:7px 0 7px 16px;border-bottom:1px solid rgba(43,49,57,.6);font-size:13.5px}
ul.bul li:last-child{border-bottom:0}
ul.bul li:before{content:"";position:absolute;left:0;top:14px;width:5px;height:5px;border-radius:var(--r-pill);background:var(--primary)}
ul.bul li b{color:#fff;font-weight:600}
.tagrow{display:flex;flex-wrap:wrap;gap:8px;margin:4px 0 14px}
.tag{font-size:11.5px;font-weight:600;padding:5px 11px;border-radius:var(--r-pill);background:var(--elev);color:var(--body)}
.tag.y{background:var(--primary);color:var(--ink)}
.tag.g{background:rgba(14,203,129,.14);color:var(--up)}
.tag.r{background:rgba(246,70,93,.14);color:var(--down)}

.movers{display:grid;grid-template-columns:repeat(auto-fit,minmax(118px,1fr));gap:10px;margin-top:4px}
.mv{background:var(--elev);border-radius:var(--r-lg);padding:11px 12px}
.mv .s{font-size:13px;font-weight:600;letter-spacing:.02em}
.mv .p{font-size:12px;color:var(--muted-strong);margin-top:3px}
.mv .c{font-size:15px;font-weight:600;margin-top:3px}

.bars{margin-top:2px}
.brow{display:grid;grid-template-columns:150px 1fr 62px;align-items:center;gap:10px;padding:4px 0;font-size:12.5px}
.brow .nm{color:var(--body);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.track{height:7px;background:rgba(43,49,57,.9);border-radius:var(--r-pill);position:relative;overflow:hidden}
.fill{position:absolute;top:0;bottom:0;border-radius:var(--r-pill)}
.fill.pos{background:var(--up);left:50%}
.fill.neg{background:var(--down);right:50%}
.brow .pc{text-align:right;font-weight:600}

.stage{display:grid;grid-template-columns:repeat(4,1fr);gap:1px;background:var(--hairline);border:1px solid var(--hairline);border-radius:var(--r-lg);overflow:hidden;margin-top:12px}
.st{background:var(--elev);padding:12px 14px}
.st .n{font-size:11px;color:var(--muted);text-transform:uppercase;letter-spacing:.05em}
.st .v{font-size:20px;font-weight:700;margin-top:4px}
.st .p{font-size:12px;color:var(--muted-strong)}
.stbar{display:flex;height:10px;border-radius:var(--r-pill);overflow:hidden;margin-top:12px;background:var(--elev)}
.stbar i{display:block}

table.scan{width:100%;border-collapse:collapse;font-size:12.5px}
table.scan th{text-align:left;font-size:11px;font-weight:600;color:var(--muted);text-transform:uppercase;letter-spacing:.04em;padding:9px 8px;border-bottom:1px solid var(--hairline);white-space:nowrap}
table.scan td{padding:10px 8px;border-bottom:1px solid rgba(43,49,57,.55);vertical-align:top}
table.scan tr:last-child td{border-bottom:0}
table.scan td.sym{font-weight:700;font-size:13px;white-space:nowrap}
table.scan td.rs{white-space:nowrap}
.rs6{color:var(--primary);font-weight:600}
.rs3{color:var(--muted-strong)}
.pill{display:inline-block;font-size:10.5px;font-weight:700;padding:3px 8px;border-radius:var(--r-pill);white-space:nowrap}
.p-shallow{background:rgba(14,203,129,.16);color:var(--up)}
.p-mid{background:rgba(252,213,53,.16);color:var(--primary)}
.p-50{background:rgba(45,189,182,.18);color:var(--turq)}
.p-deep{background:rgba(246,70,93,.16);color:var(--down)}
.hot{color:var(--primary)}
.note{color:var(--muted-strong);font-size:12px}
.good{color:var(--up);font-weight:600}
.warn{color:var(--down);font-weight:600}
.grp{background:var(--elev)}
.grp td{font-size:12px;font-weight:700;letter-spacing:.04em;color:var(--primary);padding:9px 8px}
.tblwrap{overflow-x:auto}

.risk li{font-size:13.5px}
.risk li:before{background:var(--down)}
footer{border-top:1px solid var(--hairline);padding-top:18px;color:var(--muted);font-size:11.5px;line-height:1.7}
@media(max-width:860px){.grid2,.grid3{grid-template-columns:1fr}h1{font-size:30px}.brow{grid-template-columns:118px 1fr 56px}}
</style>